{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/:part/outputs/:clip",
      "destination": "/artifacts/:part/outputs/:clip"
    },
    {
      "source": "/:part/:clip",
      "destination": "/artifacts/:part/outputs/:clip"
    }
  ]
}
